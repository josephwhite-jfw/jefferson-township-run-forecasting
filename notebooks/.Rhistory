if (all(candidates %in% names(panel))) {
panel <- panel |>
mutate(runs_residential_ems = ems_calls -
coalesce(runs_apartment_ems, 0) -
coalesce(runs_sage_ems, 0) -
coalesce(runs_taylor_ems, 0)) |>
mutate(runs_residential_ems = if_else(runs_residential_ems < 0, NA_real_, runs_residential_ems))
}
}
# 4) Modeling utilities -------------------------------------------------------
safe_glm_nb <- function(formula, data, maxit_vec = c(50, 200), init_theta = c(1, 2, 5)) {
for (mx in maxit_vec) {
for (th in init_theta) {
fit <- try(MASS::glm.nb(formula, data = data, control = glm.control(maxit = mx), init.theta = th), silent = TRUE)
if (!inherits(fit, "try-error")) return(fit)
}
}
message("NB failed to converge; falling back to quasi-Poisson.")
glm(formula, data = data, family = quasipoisson(link = "log"))
}
tidy_robust <- function(fit) {
vc <- sandwich::vcovHC(fit, type = "HC1")
broom::tidy(lmtest::coeftest(fit, vcov. = vc))
}
fit_pair <- function(formula, data, seasonal = c("fe","harmonic")) {
seasonal <- match.arg(seasonal)
df <- data |> tidyr::drop_na(all.vars(formula))
if (nrow(df) == 0) return(NULL)
pois <- glm(formula, data = df, family = poisson(link = "log"))
nb   <- safe_glm_nb(formula, data = df)
list(pois = pois, nb = nb, df = df)
}
# 5) Build targeted models ----------------------------------------------------
models <- list()
has_sage   <- "beds_sage_park" %in% names(panel)
has_taylor <- "beds_taylor_springs" %in% names(panel)
# Township-wide EMS (context): residents/workers + month FE
if (all(c("ems_calls","est_residents_total_lag6","est_workers_total_lag6","month_num") %in% names(panel))) {
models$ems <- fit_pair(ems_calls ~ est_residents_total_lag6 + est_workers_total_lag6 + month_num,
panel, seasonal = "fe")
}
# Township-wide Fire (context): sqft + month FE
fire_preds <- c("res_sf_area_sqft_k_lag6","res_mf_area_sqft_k_lag6","com_area_sqft_k_lag6","ind_area_sqft_k_lag6")
if (all(c("fire_calls","month_num") %in% names(panel)) && any(fire_preds %in% names(panel))) {
keep <- intersect(fire_preds, names(panel))
rhs  <- paste(c(keep,"month_num"), collapse = " + ")
models$fire <- fit_pair(as.formula(paste("fire_calls ~", rhs)), panel, seasonal = "fe")
}
# Facilities: runs ~ own beds (harmonics)
if (has_sage) {
for (y in c("runs_sage_total","runs_sage_ems","runs_sage_fire")) {
if (all(c(y,"beds_sage_park","s1","c1","s2","c2") %in% names(panel))) {
models[[paste0("sage_", sub("runs_sage_", "", y))]] <-
fit_pair(as.formula(paste0(y," ~ beds_sage_park + s1 + c1 + s2 + c2")), panel, seasonal = "harmonic")
}
}
}
if (has_taylor) {
for (y in c("runs_taylor_total","runs_taylor_ems","runs_taylor_fire")) {
if (all(c(y,"beds_taylor_springs","s1","c1","s2","c2") %in% names(panel))) {
models[[paste0("taylor_", sub("runs_taylor_", "", y))]] <-
fit_pair(as.formula(paste0(y," ~ beds_taylor_springs + s1 + c1 + s2 + c2")), panel, seasonal = "harmonic")
}
}
}
# Apartments: EMS ~ MF residents (lag6 if available) + month FE; Fire ~ MF sqft + month FE
if (all(c("runs_apartment_ems","month_num") %in% names(panel))) {
x_mf_res <- if ("est_residents_mf_lag6" %in% names(panel)) "est_residents_mf_lag6"
else if ("est_residents_mf" %in% names(panel)) "est_residents_mf" else NA
x_mf_sqk <- if ("res_mf_area_sqft_k_lag6" %in% names(panel)) "res_mf_area_sqft_k_lag6"
else if ("res_mf_area_sqft_k" %in% names(panel)) "res_mf_area_sqft_k" else NA
rhs <- na.omit(c(x_mf_res, x_mf_sqk))
if (length(rhs)) {
models$apt_ems <- fit_pair(as.formula(paste("runs_apartment_ems ~", paste(c(rhs,"month_num"), collapse = " + "))),
panel, seasonal = "fe")
}
}
if (all(c("runs_apartment_fire","month_num") %in% names(panel))) {
x_mf_sqk <- if ("res_mf_area_sqft_k_lag6" %in% names(panel)) "res_mf_area_sqft_k_lag6"
else if ("res_mf_area_sqft_k" %in% names(panel)) "res_mf_area_sqft_k" else NA
rhs <- na.omit(c(x_mf_sqk))
if (length(rhs)) {
models$apt_fire <- fit_pair(as.formula(paste("runs_apartment_fire ~", paste(c(rhs,"month_num"), collapse = " + "))),
panel, seasonal = "fe")
}
}
# Residential EMS: ~ residential population (SF + MF) lags + month FE
if ("runs_residential_ems" %in% names(panel) && "month_num" %in% names(panel)) {
rhs <- c()
if ("est_residents_sf_lag6" %in% names(panel)) rhs <- c(rhs, "est_residents_sf_lag6")
if ("est_residents_mf_lag6" %in% names(panel)) rhs <- c(rhs, "est_residents_mf_lag6")
if (length(rhs)) {
models$res_ems <- fit_pair(as.formula(paste("runs_residential_ems ~", paste(c(rhs,"month_num"), collapse = " + "))),
panel, seasonal = "fe")
}
}
# Commercial Fire: ~ commercial sqft (lag6 preferred) + month FE
if ("month_num" %in% names(panel)) {
if ("runs_commercial_fire" %in% names(panel)) {
if ("com_area_sqft_k_lag6" %in% names(panel)) {
models$com_fire <- fit_pair(runs_commercial_fire ~ com_area_sqft_k_lag6 + month_num, panel, seasonal = "fe")
} else if ("com_area_sqft_k" %in% names(panel)) {
models$com_fire <- fit_pair(runs_commercial_fire ~ com_area_sqft_k + month_num, panel, seasonal = "fe")
}
} else if (all(c("fire_calls","com_area_sqft_k_lag6") %in% names(panel))) {
# Fallback: township fire using commercial sqft
models$fire_com_only <- fit_pair(fire_calls ~ com_area_sqft_k_lag6 + month_num, panel, seasonal = "fe")
}
}
# Industrial Fire: ~ industrial sqft (lag6) + month FE (if available)
if ("month_num" %in% names(panel)) {
if ("runs_industrial_fire" %in% names(panel) && ("ind_area_sqft_k_lag6" %in% names(panel) || "ind_area_sqft_k" %in% names(panel))) {
rhs <- if ("ind_area_sqft_k_lag6" %in% names(panel)) "ind_area_sqft_k_lag6" else "ind_area_sqft_k"
models$ind_fire <- fit_pair(as.formula(paste("runs_industrial_fire ~", rhs, "+ month_num")), panel, seasonal = "fe")
}
}
# 6) Collect & print results ---------------------------------------------------
# Flatten model list into a named list of model objects for modelsummary
as_model_list <- function(models) {
out <- list()
add <- function(name, obj, label) {
if (is.null(obj)) return()
out[[paste0(label," (Pois)")]] <- obj$pois
out[[paste0(label," (NB)")]]   <- obj$nb
}
add("ems",           models$ems,            "EMS (township)")
add("fire",          models$fire,           "Fire (township)")
add("sage_tot",      models$sage_total,     "Sage total")
add("sage_ems",      models$sage_ems,       "Sage EMS")
add("sage_fire",     models$sage_fire,      "Sage Fire")
add("taylor_tot",    models$taylor_total,   "Taylor total")
add("taylor_ems",    models$taylor_ems,     "Taylor EMS")
add("taylor_fire",   models$taylor_fire,    "Taylor Fire")
add("apt_ems",       models$apt_ems,        "Apt EMS")
add("apt_fire",      models$apt_fire,       "Apt Fire")
add("res_ems",       models$res_ems,        "Residential EMS")
add("com_fire",      models$com_fire,       "Commercial Fire")
add("fire_com_only", models$fire_com_only,  "Fire ~ Commercial sqft")
add("ind_fire",      models$ind_fire,       "Industrial Fire")
# keep only supported model objects
valid <- function(m) inherits(m, c("glm","negbin","lm"))
out[vapply(out, valid, logical(1))]
}
all_models <- as_model_list(models)
if (length(all_models) == 0) {
warning("No valid models could be estimated with available columns.")
} else {
modelsummary::modelsummary(
all_models,
gof_omit = "IC|Log|Adj|Pseudo",
output   = "markdown"
)
}
# 7) Quick marginal effects @ mean (optional view) ----------------------------
me_at_mean <- function(fit, y) {
mu <- mean(y, na.rm = TRUE)
vc <- sandwich::vcovHC(fit, type = "HC1")
est <- lmtest::coeftest(fit, vcov. = vc) |> broom::tidy()
est |>
filter(term != "(Intercept)") |>
transmute(term,
estimate = estimate,
`Δruns/month @ mean` = estimate * mu,
`p.value` = p.value)
}
cat("\n── Marginal effects (selected) ──\n")
if (!is.null(models$fire))  print(me_at_mean(models$fire$pois,  models$fire$df$fire_calls))
if (!is.null(models$ems))   print(me_at_mean(models$ems$pois,   models$ems$df$ems_calls))
if (!is.null(models$apt_ems))  print(me_at_mean(models$apt_ems$pois,  models$apt_ems$df$runs_apartment_ems))
if (!is.null(models$apt_fire)) print(me_at_mean(models$apt_fire$pois, models$apt_fire$df$runs_apartment_fire))
if (!is.null(models$res_ems))  print(me_at_mean(models$res_ems$pois,  models$res_ems$df$runs_residential_ems))
if (!is.null(models$sage_total))   print(me_at_mean(models$sage_total$pois,   models$sage_total$df$runs_sage_total))
if (!is.null(models$taylor_total)) print(me_at_mean(models$taylor_total$pois, models$taylor_total$df$runs_taylor_total))
View(as_model_list)
View(models)
# ─────────────────────────────────────────────────────────────────────────────
# Jefferson Township – Targeted monthly run models (final)
#   • Uses: runs_taylor_total_raw, runs_sage_total  (as requested)
#   • Scales effects to readable units:
#       - +100 beds, +1,000 residents, +10,000 sqft, +100 workers
#   • Industrial: Fire ~ industrial sqft; EMS ~ industrial workers
#   • Apartments: EMS ~ MF residents (or MF sqft), Fire ~ MF sqft
#   • Residential EMS ~ residential (SF+MF) residents
#   • Robust HC1 SE; “safe” NegBin with fallback; month FE or harmonic seasonality
# ─────────────────────────────────────────────────────────────────────────────
# 0) Packages -----------------------------------------------------------------
req <- c("here","tidyverse","lubridate","janitor","broom","MASS",
"sandwich","lmtest","modelsummary")
inst <- rownames(installed.packages())
if (any(!req %in% inst)) install.packages(setdiff(req, inst))
invisible(lapply(req, library, character.only = TRUE))
# 1) Read panel ---------------------------------------------------------------
PANEL_PATH <- here::here("data","clean","panel_monthly_with_parcels.csv")
panel <- readr::read_csv(PANEL_PATH, show_col_types = FALSE) |>
janitor::clean_names()
stopifnot(all(c("month","ems_calls","fire_calls") %in% names(panel)))
panel <- panel |>
mutate(month = as.Date(month),
month_num = factor(lubridate::month(month)))
# 2) Seasonality helpers (harmonics for sparse facility series) ---------------
panel <- panel |>
mutate(m  = lubridate::month(month),
s1 = sin(2*pi*m/12), c1 = cos(2*pi*m/12),
s2 = sin(4*pi*m/12), c2 = cos(4*pi*m/12))
# 3) Lags & derived exposures -------------------------------------------------
lag_if_missing <- function(df, var, k = 6) {
lag_col <- paste0(var, "_lag", k)
if (var %in% names(df) && !(lag_col %in% names(df))) {
df[[lag_col]] <- dplyr::lag(df[[var]], k)
}
df
}
# Common lags we might want
to_lag <- c(
"est_residents_total","est_workers_total",
"est_residents_mf","est_residents_sf",
"com_area_sqft_k","ind_area_sqft_k","res_mf_area_sqft_k","res_sf_area_sqft_k"
)
for (v in to_lag) panel <- lag_if_missing(panel, v, 6)
# If MF residents missing but MF sqft exists, estimate with 1.4 / 1k sqft
if (!"est_residents_mf" %in% names(panel) && "res_mf_area_sqft" %in% names(panel)) {
panel <- panel |> mutate(est_residents_mf = (res_mf_area_sqft / 1000) * 1.4)
panel <- lag_if_missing(panel, "est_residents_mf", 6)
}
# If SF residents missing but SF sqft exists, estimate with 0.9 / 1k sqft
if (!"est_residents_sf" %in% names(panel) && "res_sf_area_sqft" %in% names(panel)) {
panel <- panel |> mutate(est_residents_sf = (res_sf_area_sqft / 1000) * 0.9)
panel <- lag_if_missing(panel, "est_residents_sf", 6)
}
# Industrial workers proxy if absent: 1.0 jobs / 1k sqft (matches builder default)
if (!"est_workers_ind" %in% names(panel)) {
if ("ind_area_sqft" %in% names(panel)) {
panel <- panel |> mutate(est_workers_ind = ind_area_sqft / 1000 * 1.0)
} else if ("ind_area_sqft_k" %in% names(panel)) {
panel <- panel |> mutate(est_workers_ind = ind_area_sqft_k * 1.0)  # already in 1,000 sqft
}
}
panel <- lag_if_missing(panel, "est_workers_ind", 6)
# Residential EMS (derived if missing): EMS minus apartment + facilities
if (!"runs_residential_ems" %in% names(panel)) {
have <- c("ems_calls","runs_apartment_ems","runs_sage_ems","runs_taylor_ems")
if (all(have %in% names(panel))) {
panel <- panel |>
mutate(runs_residential_ems = ems_calls -
coalesce(runs_apartment_ems, 0) -
coalesce(runs_sage_ems, 0) -
coalesce(runs_taylor_ems, 0)) |>
mutate(runs_residential_ems = if_else(runs_residential_ems < 0, NA_real_, runs_residential_ems))
}
}
# 4) Modeling utilities -------------------------------------------------------
safe_glm_nb <- function(formula, data, maxit_vec = c(50, 200), init_theta = c(1, 2, 5)) {
for (mx in maxit_vec) {
for (th in init_theta) {
fit <- try(MASS::glm.nb(formula, data = data,
control = glm.control(maxit = mx),
init.theta = th), silent = TRUE)
if (!inherits(fit, "try-error")) return(fit)
}
}
message("NB failed to converge; falling back to quasi-Poisson.")
glm(formula, data = data, family = quasipoisson(link = "log"))
}
tidy_robust <- function(fit) {
vc <- sandwich::vcovHC(fit, type = "HC1")
broom::tidy(lmtest::coeftest(fit, vcov. = vc))
}
fit_pair <- function(formula, data) {
df <- data |> tidyr::drop_na(all.vars(formula))
if (nrow(df) == 0) return(NULL)
pois <- glm(formula, data = df, family = poisson(link = "log"))
nb   <- safe_glm_nb(formula, data = df)
list(pois = pois, nb = nb, df = df)
}
# Pretty marginal effects in digestible units (log-link @ mean)
# scale_by = how much you increase the predictor (units of the predictor)
pretty_me <- function(fit, y_vec, var, label, scale_by, unit_label) {
est <- tidy_robust(fit)
if (!(var %in% est$term)) return(tibble())
mu  <- mean(y_vec, na.rm = TRUE)
beta <- est$estimate[est$term == var]
pval <- est$p.value[est$term == var]
me_month <- beta * mu * scale_by
tibble(
variable = label,
increase = paste0("+", scales::comma(scale_by), " ", unit_label),
delta_runs_per_month = me_month,
delta_runs_per_year  = me_month * 12,
p_value = pval
)
}
# 5) Build models --------------------------------------------------------------
models <- list()
has_sage   <- "beds_sage_park" %in% names(panel)
has_taylor <- "beds_taylor_springs" %in% names(panel)
# Township-wide EMS (context): residents/workers + month FE
if (all(c("ems_calls","est_residents_total_lag6","est_workers_total_lag6","month_num") %in% names(panel))) {
models$ems <- fit_pair(ems_calls ~ est_residents_total_lag6 + est_workers_total_lag6 + month_num, panel)
}
# Township-wide Fire (context): sqft + month FE
fire_preds <- c("res_sf_area_sqft_k_lag6","res_mf_area_sqft_k_lag6","com_area_sqft_k_lag6","ind_area_sqft_k_lag6")
if (all(c("fire_calls","month_num") %in% names(panel)) && any(fire_preds %in% names(panel))) {
keep <- intersect(fire_preds, names(panel))
rhs  <- paste(c(keep,"month_num"), collapse = " + ")
models$fire <- fit_pair(as.formula(paste("fire_calls ~", rhs)), panel)
}
# Facilities: runs ~ own beds (harmonics; use trusted columns)
# Sage: runs_sage_total ~ beds_sage_park + harmonics
if (has_sage && all(c("runs_sage_total","beds_sage_park","s1","c1","s2","c2") %in% names(panel))) {
models$sage_total <- fit_pair(runs_sage_total ~ beds_sage_park + s1 + c1 + s2 + c2, panel)
}
# Taylor: runs_taylor_total_raw ~ beds_taylor_springs + harmonics
if (has_taylor && all(c("runs_taylor_total_raw","beds_taylor_springs","s1","c1","s2","c2") %in% names(panel))) {
models$taylor_total <- fit_pair(runs_taylor_total_raw ~ beds_taylor_springs + s1 + c1 + s2 + c2, panel)
}
# Apartments:
# EMS ~ MF residents (lag6 preferred, else level) + month FE
if (all(c("runs_apartment_ems","month_num") %in% names(panel))) {
x_mf_res <- if ("est_residents_mf_lag6" %in% names(panel)) "est_residents_mf_lag6"
else if ("est_residents_mf" %in% names(panel)) "est_residents_mf" else NA
x_mf_sqk <- if ("res_mf_area_sqft_k_lag6" %in% names(panel)) "res_mf_area_sqft_k_lag6"
else if ("res_mf_area_sqft_k" %in% names(panel)) "res_mf_area_sqft_k" else NA
rhs <- na.omit(c(x_mf_res, x_mf_sqk, "month_num"))
if (length(rhs)) {
models$apt_ems <- fit_pair(as.formula(paste("runs_apartment_ems ~", paste(rhs, collapse = " + "))), panel)
}
}
# Fire ~ MF sqft (lag6 preferred) + month FE
if (all(c("runs_apartment_fire","month_num") %in% names(panel))) {
x_mf_sqk <- if ("res_mf_area_sqft_k_lag6" %in% names(panel)) "res_mf_area_sqft_k_lag6"
else if ("res_mf_area_sqft_k" %in% names(panel)) "res_mf_area_sqft_k" else NA
rhs <- na.omit(c(x_mf_sqk, "month_num"))
if (length(rhs)) {
models$apt_fire <- fit_pair(as.formula(paste("runs_apartment_fire ~", paste(rhs, collapse = " + "))), panel)
}
}
# Residential EMS ~ residents (SF+MF) (lags) + month FE
if ("runs_residential_ems" %in% names(panel) && "month_num" %in% names(panel)) {
rhs <- c()
if ("est_residents_sf_lag6" %in% names(panel)) rhs <- c(rhs, "est_residents_sf_lag6")
if ("est_residents_mf_lag6" %in% names(panel)) rhs <- c(rhs, "est_residents_mf_lag6")
if (length(rhs)) {
models$res_ems <- fit_pair(as.formula(paste("runs_residential_ems ~", paste(c(rhs,"month_num"), collapse = " + "))), panel)
}
}
# Industrial:
# Fire: (preferred) runs_industrial_fire ~ ind_area_sqft_k_lag6 + month FE
if ("month_num" %in% names(panel)) {
if ("runs_industrial_fire" %in% names(panel) && any(c("ind_area_sqft_k_lag6","ind_area_sqft_k") %in% names(panel))) {
x_ind <- if ("ind_area_sqft_k_lag6" %in% names(panel)) "ind_area_sqft_k_lag6" else "ind_area_sqft_k"
models$ind_fire <- fit_pair(as.formula(paste("runs_industrial_fire ~", x_ind, "+ month_num")), panel)
} else if (all(c("fire_calls","ind_area_sqft_k_lag6","month_num") %in% names(panel))) {
# Fallback: township fire explained by industrial sqft only
models$fire_ind_only <- fit_pair(fire_calls ~ ind_area_sqft_k_lag6 + month_num, panel)
}
}
# EMS: (preferred) runs_industrial_ems ~ est_workers_ind_lag6 + month FE
if ("month_num" %in% names(panel)) {
if ("runs_industrial_ems" %in% names(panel) && any(c("est_workers_ind_lag6","est_workers_ind") %in% names(panel))) {
x_w <- if ("est_workers_ind_lag6" %in% names(panel)) "est_workers_ind_lag6" else "est_workers_ind"
models$ind_ems <- fit_pair(as.formula(paste("runs_industrial_ems ~", x_w, "+ month_num")), panel)
} else if (all(c("ems_calls","est_workers_ind_lag6","month_num") %in% names(panel))) {
# Fallback: township EMS explained by industrial workers only
models$ems_ind_only <- fit_pair(ems_calls ~ est_workers_ind_lag6 + month_num, panel)
}
}
# 6) Model table (optional) ---------------------------------------------------
as_model_list <- function(models) {
out <- list()
add <- function(obj, label) {
if (is.null(obj)) return()
out[[paste0(label," (Pois)")]] <- obj$pois
out[[paste0(label," (NB)")]]   <- obj$nb
}
add(models$ems,              "EMS (township)")
add(models$fire,             "Fire (township)")
add(models$sage_total,       "Sage total ~ beds")
add(models$taylor_total,     "Taylor total ~ beds")
add(models$apt_ems,          "Apt EMS ~ MF pop/sqft")
add(models$apt_fire,         "Apt Fire ~ MF sqft")
add(models$res_ems,          "Residential EMS ~ pop")
add(models$ind_fire,         "Industrial Fire ~ sqft")
add(models$fire_ind_only,    "Fire ~ Industrial sqft")
add(models$ind_ems,          "Industrial EMS ~ workers")
add(models$ems_ind_only,     "EMS ~ Industrial workers")
valid <- function(m) inherits(m, c("glm","negbin","lm"))
out[vapply(out, valid, logical(1))]
}
all_models <- as_model_list(models)
if (length(all_models)) {
modelsummary::modelsummary(all_models, gof_omit = "IC|Log|Adj|Pseudo", output = "markdown")
} else {
warning("No valid models could be estimated with available columns.")
}
# 7) Digestible marginal effects (annualized), using your scaling --------------
# Helpers to emit rows if a model exists
emit_if <- function(obj, rows) if (!is.null(obj) && nrow(rows)) rows else tibble()
results <- list()
## Facilities (per +100 beds)
if (!is.null(models$sage_total)) {
results$sage <- pretty_me(models$sage_total$pois,
models$sage_total$df$runs_sage_total,
"beds_sage_park",
"Sage Park: +100 beds",
scale_by = 100, unit_label = "beds")
}
if (!is.null(models$taylor_total)) {
results$taylor <- pretty_me(models$taylor_total$pois,
models$taylor_total$df$runs_taylor_total_raw,
"beds_taylor_springs",
"Taylor Springs: +100 beds",
scale_by = 100, unit_label = "beds")
}
## Apartments (EMS: +1,000 MF residents; Fire: +10,000 MF sqft)
if (!is.null(models$apt_ems)) {
# prefer residents if present; else MF sqft
coef_names <- names(coef(models$apt_ems$pois))
if ("est_residents_mf_lag6" %in% coef_names) {
results$apt_ems <- pretty_me(models$apt_ems$pois,
models$apt_ems$df$runs_apartment_ems,
"est_residents_mf_lag6",
"Apartment EMS: +1,000 MF residents",
scale_by = 1000, unit_label = "residents")
} else if ("res_mf_area_sqft_k_lag6" %in% coef_names) {
# res_mf_area_sqft_k is in 1,000 sqft; +10,000 sqft == +10 in k
results$apt_ems <- pretty_me(models$apt_ems$pois,
models$apt_ems$df$runs_apartment_ems,
"res_mf_area_sqft_k_lag6",
"Apartment EMS: +10,000 MF sqft",
scale_by = 10, unit_label = "k sqft")
}
}
if (!is.null(models$apt_fire) &&
"res_mf_area_sqft_k_lag6" %in% names(coef(models$apt_fire$pois))) {
results$apt_fire <- pretty_me(models$apt_fire$pois,
models$apt_fire$df$runs_apartment_fire,
"res_mf_area_sqft_k_lag6",
"Apartment Fire: +10,000 MF sqft",
scale_by = 10, unit_label = "k sqft")
}
## Residential EMS (SF & MF): +1,000 residents
if (!is.null(models$res_ems)) {
if ("est_residents_sf_lag6" %in% names(coef(models$res_ems$pois))) {
results$res_ems_sf <- pretty_me(models$res_ems$pois,
models$res_ems$df$runs_residential_ems,
"est_residents_sf_lag6",
"Residential EMS (SF): +1,000 residents",
scale_by = 1000, unit_label = "residents")
}
if ("est_residents_mf_lag6" %in% names(coef(models$res_ems$pois))) {
results$res_ems_mf <- pretty_me(models$res_ems$pois,
models$res_ems$df$runs_residential_ems,
"est_residents_mf_lag6",
"Residential EMS (MF): +1,000 residents",
scale_by = 1000, unit_label = "residents")
}
}
## Industrial Fire: +10,000 industrial sqft
if (!is.null(models$ind_fire)) {
coef_nm <- names(coef(models$ind_fire$pois))
if ("ind_area_sqft_k_lag6" %in% coef_nm) {
results$ind_fire <- pretty_me(models$ind_fire$pois,
models$ind_fire$df[[all.vars(models$ind_fire$pois$call$formula)[1]]],
"ind_area_sqft_k_lag6",
"Industrial Fire: +10,000 sqft",
scale_by = 10, unit_label = "k sqft")
} else if ("ind_area_sqft_k" %in% coef_nm) {
results$ind_fire <- pretty_me(models$ind_fire$pois,
models$ind_fire$df[[all.vars(models$ind_fire$pois$call$formula)[1]]],
"ind_area_sqft_k",
"Industrial Fire: +10,000 sqft",
scale_by = 10, unit_label = "k sqft")
}
} else if (!is.null(models$fire_ind_only)) {  # fallback on township fire
results$fire_ind_only <- pretty_me(models$fire_ind_only$pois,
models$fire_ind_only$df$fire_calls,
"ind_area_sqft_k_lag6",
"Fire (township): +10,000 industrial sqft",
scale_by = 10, unit_label = "k sqft")
}
## Industrial EMS: +100 industrial workers
if (!is.null(models$ind_ems)) {
coef_nm <- names(coef(models$ind_ems$pois))
if ("est_workers_ind_lag6" %in% coef_nm) {
results$ind_ems <- pretty_me(models$ind_ems$pois,
models$ind_ems$df[[all.vars(models$ind_ems$pois$call$formula)[1]]],
"est_workers_ind_lag6",
"Industrial EMS: +100 workers",
scale_by = 100, unit_label = "workers")
} else if ("est_workers_ind" %in% coef_nm) {
results$ind_ems <- pretty_me(models$ind_ems$pois,
models$ind_ems$df[[all.vars(models$ind_ems$pois$call$formula)[1]]],
"est_workers_ind",
"Industrial EMS: +100 workers",
scale_by = 100, unit_label = "workers")
}
} else if (!is.null(models$ems_ind_only)) {  # fallback on township EMS
results$ems_ind_only <- pretty_me(models$ems_ind_only$pois,
models$ems_ind_only$df$ems_calls,
"est_workers_ind_lag6",
"EMS (township): +100 industrial workers",
scale_by = 100, unit_label = "workers")
}
# Bind & print nice summary ----------------------------------------------------
digestible <- bind_rows(results) |>
mutate(
delta_runs_per_month = round(delta_runs_per_month, 3),
delta_runs_per_year  = round(delta_runs_per_year, 3),
p_value = signif(p_value, 3)
)
cat("\n── Digestible effects (scaled changes) ──\n")
print(digestible)

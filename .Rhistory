PANEL_PATH <- here::here("data","clean","panel_monthly_with_parcels.csv")
panel <- readr::read_csv(PANEL_PATH, show_col_types = FALSE) |> janitor::clean_names()
stopifnot("month" %in% names(panel))
panel <- panel |>
mutate(
month = as.Date(month),
m = lubridate::month(month),
s1 = sin(2*pi*m/12), c1 = cos(2*pi*m/12),
month_fe = factor(m)  # month fixed effects
)
# 2) Helpers ------------------------------------------------------------------
pick_col <- function(df, candidates) {
candidates[candidates %in% names(df)][1] %||% NA_character_
}
have_nontrivial <- function(x, min_n = 12, min_unique = 3) {
is.numeric(x) &&
sum(is.finite(x)) >= min_n &&
dplyr::n_distinct(x[is.finite(x)]) >= min_unique
}
safe_glm_nb <- function(formula, data) {
# try a few thetas / iters; fall back to quasipoisson if needed
for (th in c(1, 2, 5, 10)) {
fit <- try(MASS::glm.nb(formula, data = data,
control = glm.control(maxit = 200),
init.theta = th), silent = TRUE)
if (!inherits(fit, "try-error")) return(fit)
}
message("NB failed; falling back to quasi-Poisson.")
glm(formula, data = data, family = quasipoisson(link = "log"))
}
tidy_robust <- function(fit) {
vc <- sandwich::vcovHC(fit, type = "HC1")
broom::tidy(lmtest::coeftest(fit, vcov. = vc))
}
fit_one <- function(df, y, x, season = c("fe","harmonics")) {
season <- match.arg(season)
base_cols <- c(y, x)
keep <- base_cols
if (season == "fe") keep <- c(keep, "month_fe")
if (season == "harmonics") keep <- c(keep, "s1","c1")
dd <- df |> dplyr::select(any_of(keep)) |> tidyr::drop_na(all_of(base_cols))
if (nrow(dd) < 12 || !have_nontrivial(dd[[x]]) || !have_nontrivial(dd[[y]])) return(NULL)
if (season == "fe") {
form <- as.formula(paste0(y, " ~ ", x, " + month_fe"))
} else {
form <- as.formula(paste0(y, " ~ ", x, " + s1 + c1"))
}
pois <- glm(form, data = dd, family = poisson(link = "log"))
nb   <- safe_glm_nb(form, data = dd)
list(pois = pois, nb = nb, df = dd, y = y, x = x)
}
me_at_mean <- function(fit_obj, delta, label, unit) {
# use Poisson by default; if NB converged and is glm.nb, use that
fit <- fit_obj$pois
if (inherits(fit_obj$nb, c("negbin","glm"))) fit <- fit_obj$nb
est <- tidy_robust(fit)
if (!(fit_obj$x %in% est$term)) return(NULL)
beta <- est$estimate[est$term == fit_obj$x]
pval <- est$p.value[est$term == fit_obj$x]
mu   <- mean(fit_obj$df[[fit_obj$y]], na.rm = TRUE)
d_month <- as.numeric(beta) * mu * delta
d_year  <- d_month * 12
tibble(
question = label,
unit_increase = paste0("+", scales::comma(delta), " ", unit),
delta_runs_month = round(d_month, 3),
delta_runs_year  = round(d_year, 3),
p_value = signif(pval, 3),
model_used = class(fit)[1],
n_obs = nobs(fit)
)
}

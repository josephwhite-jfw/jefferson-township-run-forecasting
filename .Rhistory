# 3) Map questions -> candidate columns (with diagnostics)
# ─────────────────────────────────────────────────────────────────────────────
cand <- list(
# Q1–Q2: facility beds -> facility total runs
q1 = list(y = c("runs_sage_total"), x = c("beds_sage_park")),
q2 = list(y = c("runs_taylor_total"), x = c("beds_taylor_springs")),
# Q3–Q4: Apartments
q3 = list(y = c("runs_apartment_ems"),
x = c("est_residents_mf_lag6","est_residents_mf")),
q4 = list(y = c("runs_apartment_fire"),
x = c("res_mf_area_sqft_k_lag6","res_mf_area_sqft_k")),
# Q5–Q6: Commercial
q5 = list(y = c("ems_calls_bucket_commercial","ems_calls"),
x = c("est_workers_com_lag6","est_workers_com","est_workers_total_lag6","est_workers_total")),
q6 = list(y = c("fire_calls_bucket_commercial","fire_calls"),
x = c("com_area_sqft_k_lag6","com_area_sqft_k")),
# Q7–Q8: Residential (non‑apt, non‑NH)
q7 = list(y = c("ems_residential_other"),
x = c("est_residents_total_lag6","est_residents_total")),
q8 = list(y = c("fire_residential_other"),
x = c("total_res_area_sqft_k_lag6","total_res_area_sqft_k")),
# Q9: Industrial
q9 = list(y = c("fire_calls_bucket_industrial","fire_calls"),
x = c("ind_area_sqft_k_lag6","ind_area_sqft_k"))
)
# quick readiness check (counts & variation)
check_var <- function(v) {
if (!v %in% names(panel)) return(tibble(var=v, n=0, sd=NA_real_))
x <- panel[[v]]
tibble(var=v, n=sum(is.finite(x)), sd=sd(x, na.rm=TRUE))
}
diag_tbl <- purrr::map_dfr(c(unlist(lapply(cand, `[[`, "y")),
unlist(lapply(cand, `[[`, "x"))),
check_var) |>
distinct() |> arrange(desc(n), var)
cat("\n── Data readiness (non‑missing counts & sd) ──\n")
print(diag_tbl, n=Inf)
# ─────────────────────────────────────────────────────────────────────────────
# 4) Fitting utilities: try multiple X variants & seasonality, pick best AIC
# ─────────────────────────────────────────────────────────────────────────────
try_fit <- function(y, x, season = c("fe","harmonics"),
min_unique_x = 3, min_unique_y = 3, min_n = 12) {
season <- match.arg(season)
base_cols <- c(y, x)
keep <- if (season == "fe") c(base_cols, "month_fe") else c(base_cols, "s1","c1")
dd <- panel |>
dplyr::select(any_of(keep)) |>
tidyr::drop_na(all_of(base_cols))
if (nrow(dd) < min_n ||
!have_nontrivial(dd[[x]], min_n = min_n, min_unique = min_unique_x) ||
!have_nontrivial(dd[[y]], min_n = min_n, min_unique = min_unique_y)) {
return(NULL)
}
form <- if (season == "fe") as.formula(paste0(y, " ~ ", x, " + month_fe"))
else                 as.formula(paste0(y, " ~ ", x, " + s1 + c1"))
pois <- glm(form, data = dd, family = poisson(link = "log"))
nb   <- try(safe_glm_nb(form, data = dd), silent = TRUE)
if (inherits(nb, "try-error")) nb <- NULL
best <- pois; best_name <- "poisson"
if (inherits(nb, c("negbin","glm"))) {
if (!is.na(AIC(nb)) && AIC(nb) + 2 < AIC(pois)) { best <- nb; best_name <- "negbin" }
}
list(best = best, best_name = best_name, pois = pois, nb = nb, df = dd,
y = y, x = x, season = season)
}
fit_best <- function(qname, y_candidates, x_candidates,
min_unique_x = 3, min_unique_y = 3, min_n = 12) {
tried <- list()
for (y in y_candidates[y_candidates %in% names(panel)]) {
for (x in x_candidates[x_candidates %in% names(panel)]) {
for (sea in c("fe","harmonics")) {
f <- try_fit(y, x, sea, min_unique_x = min_unique_x,
min_unique_y = min_unique_y, min_n = min_n)
if (!is.null(f)) tried[[length(tried)+1]] <- f
}
}
}
if (!length(tried)) return(NULL)
tried[[ which.min(sapply(tried, function(z) AIC(z$best))) ]]
}
# ─────────────────────────────────────────────────────────────────────────────
# 5) Fit the 9 questions
# ─────────────────────────────────────────────────────────────────────────────
fits <- list(
# allow 2 distinct values for beds for the facility questions
q1 = fit_best("q1", cand$q1$y, cand$q1$x, min_unique_x = 2),
q2 = fit_best("q2", cand$q2$y, cand$q2$x, min_unique_x = 2),
# keep default min_unique_x = 3 for the rest
q3 = fit_best("q3", cand$q3$y, cand$q3$x),
q4 = fit_best("q4", cand$q4$y, cand$q4$x),
q5 = fit_best("q5", cand$q5$y, cand$q5$x),
q6 = fit_best("q6", cand$q6$y, cand$q6$x),
q7 = fit_best("q7", cand$q7$y, cand$q7$x),
q8 = fit_best("q8", cand$q8$y, cand$q8$x),
q9 = fit_best("q9", cand$q9$y, cand$q9$x)
)
# show what got used
used <- purrr::imap_dfr(fits, function(f, nm) {
if (is.null(f)) return(tibble(question = nm, y_used = NA, x_used = NA, season = NA, model = NA, aic = NA_real_, n = 0))
tibble(question = nm, y_used = f$y, x_used = f$x, season = f$season, model = f$best_name, aic = AIC(f$best), n = nobs(f$best))
})
cat("\n── Selected specs per question ──\n")
print(used)
# ─────────────────────────────────────────────────────────────────────────────
# 6) Marginal effects at the mean (runs/year) with exact y/x recorded
# ─────────────────────────────────────────────────────────────────────────────
me_one <- function(fobj, qlabel, delta, unit) {
if (is.null(fobj)) return(NULL)
fit <- fobj$best
est <- tidy_robust(fit)
if (!(fobj$x %in% est$term)) return(NULL)
beta <- est$estimate[est$term == fobj$x]
pval <- est$p.value[est$term == fobj$x]
mu   <- mean(fobj$df[[fobj$y]], na.rm = TRUE)
d_month <- as.numeric(beta) * mu * delta
tibble(
question = qlabel,
y_var = fobj$y, x_var = fobj$x,
season = fobj$season, model = class(fit)[1],
n_obs = nobs(fit),
unit_increase = paste0("+", scales::comma(delta), " ", unit),
delta_runs_month = round(d_month, 3),
delta_runs_year  = round(12 * d_month, 3),
p_value = signif(pval, 3)
)
}
effects_tbl <- dplyr::bind_rows(
me_one(fits$q1, "(1) Sage Park: +1 bed",                         1,    "bed"),
me_one(fits$q2, "(2) Taylor Springs: +1 bed",                    1,    "bed"),
me_one(fits$q3, "(3) Apts (EMS): +1,000 MF residents",           1000, "residents"),
me_one(fits$q4, "(4) Apts (Fire): +1,000 MF sqft",               1,    "k sqft"),
me_one(fits$q5, "(5) Commercial (EMS): +100 employees",          100,  "workers"),
me_one(fits$q6, "(6) Commercial (Fire): +1,000 sqft",            1,    "k sqft"),
me_one(fits$q7, "(7) Residential (EMS): +1,000 residents",       1000, "residents"),
me_one(fits$q8, "(8) Residential (Fire): +1,000 sqft",           1,    "k sqft"),
me_one(fits$q9, "(9) Industrial (Fire): +1,000 sqft",            1,    "k sqft")
)
cat("\n── Effects in requested units (runs/year) ──\n")
print(effects_tbl)
# write results
OUT_DIR <- dirname(PANEL_PATH)
readr::write_csv(effects_tbl, file.path(OUT_DIR, "nine_question_effects.csv"))
# optional: more‑precision model tables
ms_list <- list()
addm <- function(name, f) if (!is.null(f)) { ms_list[[paste(name,"Pois")]] <<- f$pois; if (!is.null(f$nb)) ms_list[[paste(name,"NB")]] <<- f$nb }
addm("(1) Sage Park", fits$q1); addm("(2) Taylor", fits$q2); addm("(3) Apt EMS", fits$q3)
addm("(4) Apt Fire", fits$q4); addm("(5) Com EMS", fits$q5); addm("(6) Com Fire", fits$q6)
addm("(7) Res EMS", fits$q7); addm("(8) Res Fire", fits$q8); addm("(9) Ind Fire", fits$q9)
if (length(ms_list)) {
options(modelsummary_digits = 6)
cat("\n── Model summaries (more precision) ──\n")
modelsummary::modelsummary(ms_list, gof_omit = "IC|Log|Adj|Pseudo", output = "markdown")
}
# Optional: model tables for inspection (only those that fit) -----------------

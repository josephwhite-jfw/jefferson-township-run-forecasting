if (!is.null(fits$q1)) { ms_list[["(1) Sage Park"]]       <- fits$q1$pois; ms_list[["(1) Sage Park NB"]] <- fits$q1$nb }
if (!is.null(fits$q2)) { ms_list[["(2) Taylor Springs"]]  <- fits$q2$pois; ms_list[["(2) Taylor NB"]]    <- fits$q2$nb }
if (!is.null(fits$q3)) { ms_list[["(3) Apt EMS"]]         <- fits$q3$pois; ms_list[["(3) Apt EMS NB"]]   <- fits$q3$nb }
if (!is.null(fits$q4)) { ms_list[["(4) Apt Fire"]]        <- fits$q4$pois; ms_list[["(4) Apt Fire NB"]]  <- fits$q4$nb }
if (!is.null(fits$q5)) { ms_list[["(5) Com EMS"]]         <- fits$q5$pois; ms_list[["(5) Com EMS NB"]]   <- fits$q5$nb }
if (!is.null(fits$q6)) { ms_list[["(6) Com Fire"]]        <- fits$q6$pois; ms_list[["(6) Com Fire NB"]]  <- fits$q6$nb }
if (!is.null(fits$q7)) { ms_list[["(7) Res EMS"]]         <- fits$q7$pois; ms_list[["(7) Res EMS NB"]]   <- fits$q7$nb }
if (!is.null(fits$q8)) { ms_list[["(8) Res Fire"]]        <- fits$q8$pois; ms_list[["(8) Res Fire NB"]]  <- fits$q8$nb }
if (!is.null(fits$q9)) { ms_list[["(9) Ind Fire"]]        <- fits$q9$pois; ms_list[["(9) Ind Fire NB"]]  <- fits$q9$nb }
if (length(ms_list)) {
cat("\n── Model summaries (for diagnostics) ──\n")
modelsummary::modelsummary(ms_list, gof_omit = "IC|Log|Adj|Pseudo", output = "markdown")
} else {
cat("\n(No models could be estimated — likely missing columns or zero variation. Check colmap and panel contents.)\n")
}

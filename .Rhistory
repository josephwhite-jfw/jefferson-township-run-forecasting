# panel_diff_model.R
# ────────────────────────────────────────────────────────────────────────────────
# 0) Load packages
# ────────────────────────────────────────────────────────────────────────────────
library(here)        # project‐root paths
library(tidyverse)   # read_csv, dplyr, etc.
library(lubridate)   # ymd, month()
library(stringr)     # str_detect()
library(broom)       # tidy(), glance()
# ────────────────────────────────────────────────────────────────────────────────
# 1) Read in enhanced panel using here()
# ────────────────────────────────────────────────────────────────────────────────
panel <- read_csv(here("data", "clean", "panel_dataset_enhanced.csv"))
# ────────────────────────────────────────────────────────────────────────────────
# 2) Create time controls & lagged runs
# ────────────────────────────────────────────────────────────────────────────────
panel <- panel %>%
mutate(
# parse month and build seasonal factor
month        = ymd(month),
month_factor = factor(month(month),
levels = 1:12,
labels = month.abb),
# linear time trend
trend    = row_number(),
# one‐month lag of total_runs
runs_lag1 = lag(total_runs)
)
# ────────────────────────────────────────────────────────────────────────────────
# 3) Identify all sqft_ columns
# ────────────────────────────────────────────────────────────────────────────────
sqft_cols <- names(panel)[ str_detect(names(panel), "^sqft_") ]
# ────────────────────────────────────────────────────────────────────────────────
# 4) Compute first‐differences for runs, parcels, beds, and all sqft_*
# ────────────────────────────────────────────────────────────────────────────────
panel <- panel %>%
mutate(
diff_runs        = total_runs - runs_lag1,
diff_new_parcels = new_parcels - lag(new_parcels),
diff_beds        = total_certified_beds - lag(total_certified_beds),
across(
all_of(sqft_cols),
~ . - lag(.),
.names = "diff_{.col}"
)
) %>%
filter(!is.na(diff_runs))  # drop first row with NA
# ────────────────────────────────────────────────────────────────────────────────
# 5) Build formula dynamically
# ────────────────────────────────────────────────────────────────────────────────
diff_terms   <- paste0("diff_", sqft_cols, collapse = " + ")
formula_diff <- as.formula(
paste(
"diff_runs ~",
diff_terms,
"+ diff_new_parcels + diff_beds + month_factor + trend"
)
)
# ────────────────────────────────────────────────────────────────────────────────
# 6) Fit the differenced model
# ────────────────────────────────────────────────────────────────────────────────
mod_diff <- lm(formula_diff, data = panel)
# ────────────────────────────────────────────────────────────────────────────────
# 7) Output results
# ────────────────────────────────────────────────────────────────────────────────
# Console summary
print(glance(mod_diff))
print(tidy(mod_diff, conf.int = TRUE))
